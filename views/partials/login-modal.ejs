<!-- views/partials/login-modal.ejs (Versión sin estilos) -->
<div id="login-modal">
    <hr>
    <div>
        <button id="close-login">✖</button>
        <h3>Iniciar Sesión o Registrarse (login-modal)</h3>
        <div>
            <button id="show-login">Entrar con e-mail y contraseña</button>
            <a href="/register"><button>Registrarse</button></a>
        </div>
        <div id="login-form">
            <input type="email" placeholder="Correo electrónico">
            <input type="password" placeholder="Contraseña">
            <button>Iniciar Sesión</button>
        </div>
    </div>
    <hr>
</div>
