<!-- views/partials/cart.ejs (Versión sin estilos) -->
<aside id="cart">
    <hr>
    <h3>Carrito de Compras (cart)</h3>
    <button id="close-cart">✖</button> <!-- Botón para cerrar carrito -->
    
    <!-- Sección para cargar dinámicamente los productos en el carrito -->
    <div id="cart-items">
        <!-- Los productos en el carrito serán cargados dinámicamente desde sessionStorage. -->
    </div>
    
    <p>Total: <span id="cart-total">$0</span></p>
    <button id="checkout">Continuar Checkout</button>
    <hr>
</aside>

<script src="/js/main.js"></script>

<script>
    // Función para actualizar el carrito con los datos almacenados en sessionStorage
    function updateCart() {
        let cart = JSON.parse(sessionStorage.getItem('cart')) || [];
        let cartContainer = document.getElementById('cart-items');
        let totalContainer = document.getElementById('cart-total');
        cartContainer.innerHTML = ""; // Limpiar contenido previo
        let total = 0;
        
        cart.forEach(product => {
            let productElement = document.createElement('div');
            productElement.innerHTML = `
                <img src="${product.image}" alt="${product.name}">
                <div>
                    <p>${product.name}</p>
                    <select class="quantity-selector" data-code="${product.code}">
                        <option value="1" ${product.quantity == 1 ? 'selected' : ''}>1</option>
                        <option value="2" ${product.quantity == 2 ? 'selected' : ''}>2</option>
                        <option value="3" ${product.quantity == 3 ? 'selected' : ''}>3</option>
                        <option value="4" ${product.quantity == 3 ? 'selected' : ''}>4</option>
                        <option value="5" ${product.quantity == 3 ? 'selected' : ''}>5</option>
                        <option value="6" ${product.quantity == 3 ? 'selected' : ''}>6</option>
                    </select>
                    <p>${product.price}</p>
                </div>
                <button class="remove-item" data-code="${product.code}">🗑</button>
            `;
            cartContainer.appendChild(productElement);
            total += parseFloat(product.price.replace('$', '')) * (product.quantity || 1);
        });
        
        totalContainer.innerText = `$${total.toFixed(2)}`;
        
        // Agregar eventos a los botones de eliminar
        document.querySelectorAll('.remove-item').forEach(button => {
            button.addEventListener('click', function() {
                removeFromCart(this.getAttribute('data-code'));
            });
        });
    }

    // Función para eliminar un producto del carrito
    function removeFromCart(productCode) {
        let cart = JSON.parse(sessionStorage.getItem('cart')) || [];
        
        // Filtrar el producto a eliminar
        cart = cart.filter(product => product.code !== productCode);
        
        // Guardar el carrito actualizado en sessionStorage
        sessionStorage.setItem('cart', JSON.stringify(cart));
        
        // Volver a actualizar la vista del carrito
        updateCart();
    }

       // Ejecutar la función al cargar la vista
    window.onload = updateCart;
</script>
