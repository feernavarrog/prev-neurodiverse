<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Productos - NeuroDiverse</title>
    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/homestyle.css" />
  <link rel="stylesheet" href="/css/products-admin.css" />
</head>
<body>
    <%- include('partials/first-nav') %> 
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>
    <%- include('partials/cart') %>
    <%- include('partials/login-modal') %>
    <%- include('partials/product_modal') %>
    
    <!-- Contenido principal -->
    <main class="admin-main">
        <h2 class="admin-title">Administración de Productos</h2>
        <p class="admin-description">Aquí puedes gestionar los productos de la tienda.</p>
        <hr class="divider">
        
        <!-- Tabla de productos -->
        <table id="admin-products-table" class="table admin-table" border="1">
            <thead>
                <tr>
                    <th class="table-header">Imagen</th>
                    <th class="table-header">Código</th>
                    <th class="table-header">Nombre</th>
                    <th class="table-header">Categoría</th>
                    <th class="table-header">Precio</th>
                    <th class="table-header">Stock</th>
                    <th class="table-header">Acción</th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-row">
                    <td><img src="/images/sample-product.png" alt="Producto" class="product-image" width="50"></td>
                    <td class="product-code">001</td>
                    <td class="product-name">Ejemplo Producto</td>
                    <td class="product-category">Gadgets</td>
                    <td class="product-price">$10.000</td>
                    <td class="product-stock">50</td>
                    <td class="product-actions">
                        <button class="btn-edit" onclick="editProduct('001', 'Ejemplo Producto', 'Gadgets', '10000', '50', '/images/sample-product.png', 'Descripcion', '5000', 'Marca Ejemplo', 'Activo')">Editar</button>
                        <button class="btn-deactivate" onclick="deactivateProduct('001')">Desactivar</button>
                    </td>
                </tr>
            </tbody>
        </table>
        <hr class="divider">
        
        <!-- Tabla dinámica generada con JavaScript -->
        <table id="dynamic-admin-products-table" class="table dynamic-products-table" border="1">
            <thead>
                <tr>
                    <th class="table-header">Imagen</th>
                    <th class="table-header">Código</th>
                    <th class="table-header">Nombre</th>
                    <th class="table-header">Categoría</th>
                    <th class="table-header">Precio</th>
                    <th class="table-header">Stock</th>
                    <th class="table-header">Acción</th>
                </tr>
            </thead>
            <tbody>
                <!-- Los datos se generarán dinámicamente -->
            </tbody>
        </table>
        <hr class="divider">
        
        <!-- Botón para agregar un nuevo producto -->
        <button class="btn-add-product" onclick="openProductModal()">Agregar Producto</button>
    </main>
    
    <%- include('partials/footer') %>
    
    <script src="/js/main.js"></script>
    
    <script>
        // Función para poblar la tabla de productos dinámicamente con datos simulados
        function loadAdminProducts() {
            let productRows = [
                { code: "002", name: "Producto A", category: "Accesorios", price: "12000", stock: 30, image: "/images/sample-product.png", description: "Descripcion A", discount: "5000", brand: "Marca A", active: "1" },
                { code: "003", name: "Producto B", category: "Electrónica", price: "25000", stock: 20, image: "/images/sample-product.png", description: "Descripcion B", discount: "4000", brand: "Marca B", active: "0" },
                { code: "004", name: "Producto C", category: "Hogar", price: "18000", stock: 10, image: "/images/sample-product.png", description: "Descripcion C", discount: "3000", brand: "Marca C", active: "1" }
            ];
    
            let tableBody = document.querySelector("#dynamic-admin-products-table tbody");
            tableBody.innerHTML = ""; // Limpiar contenido previo
    
            productRows.forEach(product => {
                let row = `
                    <tr class="table-row">
                        <td><img src="${product.image}" alt="Producto" class="product-image" width="50"></td>
                        <td class="product-code">${product.code}</td>
                        <td class="product-name">${product.name}</td>
                        <td class="product-category">${product.category}</td>
                        <td class="product-price">${product.price}</td>
                        <td class="product-stock">${product.stock}</td>
                        <td class="product-actions">
                            <button class="btn-edit" onclick="editProduct('${product.code}', '${product.name}', '${product.category}', '${product.price}', '${product.stock}', '${product.image}', '${product.description}', '${product.discount}', '${product.brand}', '${product.active}')">Editar</button>
                            <button class="btn-deactivate" onclick="deactivateProduct('${product.code}')">Desactivar</button>
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += row;
            });
        }
    
        // Función para poblar los datos en el modal de edición
        function editProduct(code, name, category, price, stock, image, description, discount, brand, active) {
            document.getElementById('product-code').value = code;
            document.getElementById('product-name').value = name;
            document.getElementById('product-category').value = category;
            document.getElementById('product-price').value = price;
            document.getElementById('product-stock').value = stock;
            document.getElementById('product-image').src = image;
            document.getElementById('product-description').value = description;
            document.getElementById('product-discount').value = discount;
            document.getElementById('product-brand').value = brand;
            document.getElementById('product-active').value = active;
    
            // Abre el modal de edición
            openProductModal();
        }
    
        // Función simulada para desactivar un producto
        function deactivateProduct(productCode) {
            console.log("Desactivando producto con código:", productCode);
            // Aquí se haría la llamada a la base de datos para cambiar el estado del producto
        }
    
        // Función para abrir el modal de producto (editar o agregar)
        function openProductModal() {
            const modal = document.getElementById("product-modal");
            modal.style.display = "block"; // Mostrar el modal
        }
    
            // Función para cerrar el modal
    function closeProductModal() {
        const modal = document.getElementById('product-modal');
        modal.style.display = 'none'; // Ocultar el modal
    }

    // Añadir un listener al botón de cierre
    document.getElementById('close-product-modal').addEventListener('click', function() {
        closeProductModal(); // Cerrar el modal cuando se hace clic en la "X"
    });

    
        // Ejecutar la función al cargar la vista
        window.onload = function() {
            //loadAdminProducts();
        };
    </script>
    
</body>
</html>





