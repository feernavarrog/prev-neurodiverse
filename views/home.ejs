    <%- include('partials/comingsoon') %>

    < <%- include('partials/footer') %>

    <script src="/js/main.js"></script>

    <script>
     
      function setTestUserSession() {
        sessionStorage.setItem(
          "user",
          JSON.stringify({
            id: "123456", // ID genérica de prueba
            firstName: "Juan",
            lastName: "Pérez",
            email: "juan.perez@example.com",
            city: "Santiago",
            street: "Av. Siempre Viva",
            streetNumber: "742",
            mobilePhone: "+56912345678",
            additionalInfo: "Ninguna",
            type: "cliente", // Tipo de usuario de prueba
          })
        );
        console.log(
          "Usuario de prueba almacenado en sessionStorage:",
          JSON.parse(sessionStorage.getItem("user"))
        );
      }

      // Ejecutar la función al cargar la vista
      window.onload = function () {
        setTestUserSession();
        updateCart();
        loadSidebarCategories();
      };
    </script>
    <script src="\js\main.js"></script>
    
