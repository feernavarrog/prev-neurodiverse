<!-- views/products.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>NProductos</title>
        <link
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet"
        />
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
        <link
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
          rel="stylesheet"
        />
        <link rel="stylesheet" href="/css/style.css" />
        <link rel="stylesheet" href="/css/homestyle.css" />
        <link rel="stylesheet" href="/css/item.css" />
        <link rel="stylesheet" href="/css/products.css" />
      </head>
    
</head>
<body>
    
    <%- include('partials/first-nav') %>
    <!-- Navbar -->
    <%- include('partials/navbar') %>
    
    <!-- Sidebar (Menú lateral) -->
    <%- include('partials/sidebar') %>
    
    <!-- Cart Sidebar -->
    <%- include('partials/cart') %>
    
    <!-- Login Modal -->
    <%- include('partials/login-modal') %>
    
    
    
    
    
    <!-- Contenedor donde se insertarán los productos dinámicamente -->
    <div id="product-list">
        <!-- Estos productos son solo ejemplos estáticos.
             Los productos reales deben ser insertados dinámicamente desde la base de datos,
             siguiendo este mismo patrón de estructura HTML.
             Cada producto debe contener un enlace que pase el código como parámetro en la URL.
        -->
        <div>
            
    <main class="main-products">
        
        <h2 style="text-align: center;">Fidget & Estímulos</h2> 
    <div class="product-list">
        <div class="product-descript">
            <h>
                Los fidget toys son juguetes diseñados para reducir el estrés, la ansiedad y mejorar la 
                concentración. Son pequeños, portátiles y fáciles de usar, ideales para todas las edades. 
                Estos juguetes proporcionan estimulación sensorial mediante movimientos, texturas o sonidos, 
                ayudando a mantener las manos ocupadas y la mente enfocada. Con opciones como spinners, cubos, 
                bolas antiestrés y ruedas de dedo, los fidget toys son perfectos para promover la calma y concentración 
                en cualquier entorno.
            </h>
        </div>
        <div class="product-item">
            <a href="/item?code=12345">
                <img class="product-image" src="/img/fidgetoy1.png" alt="Producto 1">
                <p class="product-name">Nombre producto 1</p>
                <p class="product-price">$100.00</p>
            </a>
        </div>
        <div class="product-item">
            <a href="/item?code=67890">
                <img class="product-image" src="/img/fidgetoy2.png" alt="Producto 2">
                <p class="product-name">Nombre producto 2</p>
                <p class="product-price">$150.00</p>
            </a>
        </div>
    </div>
</main>



    
    
    

    <!-- Footer -->
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
    
</body>
</html>
