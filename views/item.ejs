<!-- views/item.ejs (Versión sin estilos) -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Item - NeuroDiverse</title>
    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/homestyle.css" />
  <link rel="stylesheet" href="/css/item.css" />
  <link rel="stylesheet" href="/css/products.css" />
</head>
<body>
    
    <%- include('partials/first-nav') %>
    <!-- Navbar -->
    <%- include('partials/navbar') %>
    
    <!-- Sidebar (Menú lateral) -->
    <%- include('partials/sidebar') %>
    
    <!-- Cart Sidebar -->
    <%- include('partials/cart') %>
    
    <!-- Login Modal -->
    <%- include('partials/login-modal') %>
    
    
        
    <div class="main-item">
      <div class="item-container">
          <!-- Imagen del producto -->
          <img id="item-image" src="/img/fidgetoy1.png" alt="del item" class="item-image">
    
          <!-- Contenedor de los detalles del producto -->
          <div class="details-container">
              <!-- Nombre del producto -->
              <h3 id="item-name" class="item-name">Nombre del Item</h3>
    
              <!-- Precio (colocado arriba del botón de agregar al carrito) -->
              <p class="item-price">Precio: <span id="item-price">$0</span></p>
    
              <!-- Botón de agregar al carrito -->
              <button id="add-to-cart" class="add-to-cart-btn">🛒 Agregar</button>
          </div>
      </div>
    
      <!-- Descripción del producto (debajo de la imagen) -->
      <p id="item-description" class="item-description">Descripción del item...</p>
      <p class="item-info">Código: <span id="item-code">(ID en BBDD)</span></p>
    </div>
    


    <script src="/js/main.js" async></script>
        
        
        

        
    
    <!-- Footer -->
    <%- include('partials/footer') %>
    

    

</body>
</html>
