<!-- views/item.ejs (Versión sin estilos) -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Item - NeuroDiverse</title>
    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/homestyle.css" />
</head>
<body>
    
    <%- include('partials/first-nav') %>
    <!-- Navbar -->
    <%- include('partials/navbar') %>
    
    <!-- Sidebar (Menú lateral) -->
    <%- include('partials/sidebar') %>
    
    <!-- Cart Sidebar -->
    <%- include('partials/cart') %>
    
    <!-- Login Modal -->
    <%- include('partials/login-modal') %>
    
    
        <h2 class="main-title">PRODUCTO</h2>
        <main class="main-item">
        <!-- Contenedor de información del item -->
        <!-- Los datos de este item son solo de ejemplo. Todxs los campos serán cargados dinámicamente 
             al inicio de la página según el parámetro "code" pasado en la URL. -->
        <div class="item-container">
            <h3 id="item-name" class="item-name">Nombre del Item</h3>
            <img id="item-image" src="/img/fidgetoy1.png" alt="del item" class="item-image">
            <p id="item-description" class="item-description">Descripción del item...</p>
            <p class="item-info">Codigo: <span id="item-code">(ID en BBDD)</span></p>
            <p class="item-info">Precio: <span id="item-price">$0</span></p>
            <button id="add-to-cart" class="add-to-cart-btn">🛒 Agregar</button>
        </div>
    </main>


    <script src="/js/main.js" async></script>
        
        
        

        
    
    <!-- Footer -->
    <%- include('partials/footer') %>
    

    

</body>
</html>
